# ============================================================
# UTIC(도시교통정보센터) CCTV Open API 테스트용 환경변수
# ------------------------------------------------------------
# 이 파일은 "템플릿"입니다. 실제 값은 이 파일이 아니라
# 프로젝트 루트에 ".env" 라는 이름으로 복사한 뒤 채워 넣으세요.
#   cp .env.example .env
# .env 파일은 .gitignore에 등록되어 있어 Git에 올라가지 않습니다.
# ============================================================

# 발급받은 UTIC API Key (절대 코드에 직접 넣지 마세요)
UTIC_API_KEY=발급받은_키를_여기에_입력

# --------------------------------------------------------------
# 아래 값들은 UTIC에서 API Key 발급 시 함께 제공한 매뉴얼(PDF/문서)에
# 적힌 "실제" 요청 URL과 파라미터명으로 반드시 교체해야 합니다.
#
# 지금 들어있는 값은 국토교통부 계열 CCTV Open API에서 흔히 쓰이는
# 관례(key, type, minX/maxX/minY/maxY, getType)를 따른 "추정 기본값"이며,
# UTIC의 실제 스펙과 다를 수 있습니다. REPLACE_ME 상태로는 서버가
# 명확한 에러 메시지를 내며 호출을 거부합니다 (잘못된 URL을 조용히
# 호출해서 키를 낭비하지 않도록 하기 위함).
# --------------------------------------------------------------

# UTIC CCTV 조회 API의 실제 요청 URL (매뉴얼 참고 필수)
UTIC_CCTV_API_URL=REPLACE_ME_WITH_ACTUAL_UTIC_ENDPOINT

# API Key를 실어 보내는 쿼리 파라미터 이름 (예: key 또는 apiKey - 매뉴얼 확인)
UTIC_KEY_PARAM_NAME=key

# 도로 유형 등 type 파라미터 값 (예: all / its / ex - 매뉴얼 확인, 필요 없으면 비워두세요)
UTIC_TYPE_PARAM_VALUE=all

# 응답 형식 (json 또는 xml - 매뉴얼에서 지원하는 값 확인)
UTIC_GETTYPE=json

# 프록시 서버 포트
PORT=4000

# --------------------------------------------------------------
# PostGIS (이 모듈 전용 - MySQL과 별개, b_gateway와 무관)
# --------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=omecca_gis

# --------------------------------------------------------------
# b_gateway 연동 (이상운전 이벤트를 DUI_PATTERN으로도 전송)
# --------------------------------------------------------------
GATEWAY_URL=http://localhost:8080
GATEWAY_API_KEY=omecca-dev-key-2026
