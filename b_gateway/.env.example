# 이 파일을 복사해서 .env 로 만들고 값을 채운다.
#
#     copy .env.example .env        (Windows)
#     cp   .env.example .env        (macOS / Linux)
#
# OmeccaBackendApplication.main() 이 시작할 때 이 값을 읽어 System property 로 넣는다
# (dotenv-java). 그래서 터미널을 새로 열 때마다 $env: 로 다시 칠 필요가 없다.
#
# **.env 는 반드시 b_gateway 폴더 안에 있어야 하고, java -jar 도 이 폴더에서 실행해야 한다.**
# 다른 폴더에서 실행하면 파일을 못 찾고 application.yml 의 ${...} 해석이 실패해 기동이 멈춘다.
#
# .env 는 .gitignore 가 막고 있어 깃에 올라가지 않는다 (b_gateway/.gitignore:17).

# --- DB -------------------------------------------------------------------
# 본인 MySQL 계정. 값을 그대로 두면 "Access denied for user 'root'@'localhost'" 로 실패한다.
DB_USERNAME=root
DB_PASSWORD=Omecca2026!

# --- 인증 -----------------------------------------------------------------
# 팀 전체가 **같은 값**을 써야 모듈→게이트웨이 인증(X-API-Key)이 맞는다.
# 다르면 다른 모듈이 이벤트를 보낼 때 401 로 거절당한다.
GATEWAY_API_KEY=omecca-dev-local-key
JWT_SECRET=omecca-jwt-secret-change-this
