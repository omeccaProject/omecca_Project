<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.omecca</groupId>
    <artifactId>omecca-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>omecca-backend</name>
    <description>오메카3 프로젝트 - 백엔드 게이트웨이 / 관제 대시보드 API / 증거 리포트</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            DB 스키마 자동 적용 (Flyway).
            src/main/resources/db/migration 의 V*.sql 을 순서대로 한 번씩만 적용하고,
            어디까지 했는지 flyway_schema_history 테이블에 기록한다. 각자 컴퓨터에서
            schema.sql / migration_*.sql 을 손으로 돌릴 필요가 없어진다.

            flyway-mysql 을 같이 넣어야 한다. Flyway 10 부터 DB 별 지원이 분리돼서
            빠뜨리면 "Unsupported Database: MySQL" 로 기동에 실패한다.
            버전은 spring-boot-starter-parent 3.3.4 가 관리하므로 적지 않는다.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- .env 파일을 자동으로 읽어서 환경변수처럼 써주는 라이브러리.
             팀원이 매번 export/$env:로 GATEWAY_API_KEY, JWT_SECRET 등을 직접
             등록하지 않아도, 프로젝트 루트(b_gateway/)에 .env 파일 하나만
             놓으면 앱 시작 시 자동으로 로드된다. (OmeccaBackendApplication.java 참고) -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>3.0.2</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
