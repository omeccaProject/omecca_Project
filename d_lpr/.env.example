# ===========================================================================
# 비밀값 템플릿.  이 파일을 복사해서 .env 로 만들고 값을 채운다.
#
#     copy .env.example .env        (Windows)
#     cp   .env.example .env        (macOS / Linux)
#
# .env 는 .gitignore 에 있으므로 깃허브에 올라가지 않는다.
# .env.example 은 "어떤 키가 필요한지"만 알려주는 파일이라 커밋해도 된다.
# ===========================================================================

# 공공데이터포털(data.go.kr) 실시간 신호정보 서비스키
# 포털에서 주는 'Encoding' 키를 그대로 붙여넣는다 (%2B, %3D%3D 가 들어간 쪽).
SIGNAL_API_KEY=

# 신호 API 주소. KLID 교통안전 신호등 실시간 정보(15157604)를 쓰면 아래 그대로.
SIGNAL_API_URL=https://apis.data.go.kr/B551982/rti

# ITS 국가교통정보센터 CCTV 인증키 (its_cctv.py 용)
ITS_API_KEY=

# MySQL 을 쓸 때만. 비우면 SQLite 로 동작한다.
OMECCA_DB_PASSWORD=
